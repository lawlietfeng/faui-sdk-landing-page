{
  "name": "faui-sdk-landing-page",
  "description": "Documentation and demo site for the FAUI SDK",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "lawliet",
  "keywords": [
    "faui",
    "json-schema",
    "form",
    "ai-agent",
    "landing-page"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check-doc-navigation && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-docs": "node scripts/sync-docs.mjs && npm run check-doc-navigation",
    "sync-docs:check": "node scripts/sync-docs.mjs --check && npm run check-doc-navigation",
    "check-doc-navigation": "node scripts/check-doc-navigation.mjs",
    "check-doc-links": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@faui/react": "^0.0.9",
    "@lawlietfeng/faui-agent": "file:../faui-sdk-agent",
    "antd": "5.29.3",
    "axios": "^1.15.0",
    "dayjs": "^1.11.20",
    "echarts": "^6.0.0",
    "framer-motion": "^12.38.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
